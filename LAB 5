      "source": [
        "rng = np.random.default_rng(0)\n",
        "\n",
        "def add_noise(data, level):\n",
        "    \"\"\"Sprinkle random speckle on every pixel.\"\"\"\n",
        "    return np.clip(data + rng.normal(0, level, data.shape), 0, 16)\n",
