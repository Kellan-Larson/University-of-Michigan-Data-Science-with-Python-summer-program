      "source": [
        "my_digit = \"\"\"\n",
        "..####..\n",
        ".##..##.\n",
        ".##..##.\n",
        ".##..##.\n",
        ".##..##.\n",
        ".##..##.\n",
        "..####..\n",
        "........\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "def art_to_image(art):\n",
        "    \"\"\"Turn 8 lines of '.' and '#' into an 8x8 grid of 0s and 16s.\"\"\"\n",
        "    rows = art.strip(\"\\n\").split(\"\\n\")\n",
        "    rows = [r.ljust(8, \".\")[:8] for r in rows]\n",
        "    while len(rows) < 8:\n",
        "        rows.append(\".\" * 8)\n",
        "    return np.array([[0.0 if ch == \".\" else 16.0 for ch in r] for r in rows[:8]])\n",
        "\n",
        "\n",
