        "def shift_right(data, k=1):\n",
        "    images = data.reshape(-1, 8, 8)\n",
        "    return np.roll(images, k, axis=2).reshape(-1, 64)\n",
        "\n",
        "for k in [0, 1, 2]:\n",
        "    acc = accuracy_score(y_test, clf.predict(shift_right(X_test, k)))\n",
        "    print(f\"shifted {k} pixel(s):  accuracy {acc:.3f}\")"
      ]
