#### Exercise 3

## Return the gross pay for an employee based on the hourly rate and the amount
## of hours they workes. Hours over 40 are worth 1.5 times more.

def get_gross_pay(hours, rate_per_hour):
  if hours > 40:
    pay = (40 * rate_per_hour) + (hours - 40) * 1.5 * rate_per_hour
  else:
    pay = hours * rate_per_hour
  return pay

assert get_gross_pay(0, 1000) == 0
assert get_gross_pay(2, 10) == 20
